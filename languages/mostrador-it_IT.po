#. Plugin Name of the plugin
#: mostrador.php
msgid "Mostrador – NIF, precio por unidad y recargo de equivalencia"
msgstr "Mostrador – NIF, prezzo per unità e recargo de equivalencia"

#. Plugin URI of the plugin
#: mostrador.php
msgid "https://facilo.es/mostrador/"
msgstr "https://facilo.es/mostrador/"

#. Description of the plugin
#: mostrador.php
msgid "Get your WooCommerce shop ready to sell in Spain: NIF/NIE/CIF at checkout, IVA rates, price per unit, delivery times, product safety, allergens and your conditions in the order email."
msgstr "Prepara il tuo negozio WooCommerce a vendere in Spagna: NIF/NIE/CIF al checkout, aliquote IVA, prezzo per unità, tempi di consegna, sicurezza dei prodotti, allergeni e le tue condizioni nell’e-mail dell’ordine."

