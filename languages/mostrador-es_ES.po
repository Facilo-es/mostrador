#. Plugin Name of the plugin
#: mostrador.php
msgid "Mostrador – NIF, precio por unidad y recargo de equivalencia"
msgstr "Mostrador – NIF, precio por unidad y recargo de equivalencia"

#. Plugin URI of the plugin
#: mostrador.php
msgid "https://facilo.es/mostrador/"
msgstr "https://facilo.es/mostrador/"

#. Description of the plugin
#: mostrador.php
msgid "Get your WooCommerce shop ready to sell in Spain: NIF/NIE/CIF at checkout, IVA rates, price per unit, delivery times, product safety, allergens and your conditions in the order email."
msgstr "Prepara tu tienda WooCommerce para vender en España: NIF/NIE/CIF en el pago, tipos de IVA, precio por unidad, plazos de entrega, seguridad del producto, alérgenos y tus condiciones en el email del pedido."

