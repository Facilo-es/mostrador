{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mostrador/food-info",
	"title": "Food information",
	"category": "woocommerce",
	"icon": "carrot",
	"description": "Ingredients, allergens and nutrition of the current product.",
	"textdomain": "mostrador",
	"attributes": {
		"productId": { "type": "number", "default": 0 }
	},
	"supports": { "html": false, "align": false, "spacing": { "margin": true, "padding": true } },
	"usesContext": [ "postId" ],
	"editorScript": "mostrador-blocks"
}
